{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "line-endings",
      "group": "pre-commit",
      "command": "node",
      "args": ["scripts/repair-line-endings.mts", "${staged}"]
    },
    {
      "name": "eslint",
      "group": "pre-commit",
      "command": "npx",
      "args": ["--no", "--", "eslint", "--fix", "--no-warn-ignored", "${staged}"],
      "include": ["**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs", "**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"]
    },
    {
      "name": "prettier",
      "group": "pre-commit",
      "command": "npx",
      "args": ["--no", "--", "prettier", "--write", "--ignore-unknown", "${staged}"]
    },
    {
      "name": "code-style-fix",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["format", "style", "Micser.slnx", "--severity", "warn", "--no-restore", "--include", "${staged}"],
      "include": ["**/*.cs"]
    },
    {
      "name": "csharpier",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["csharpier", "format", "${staged}"],
      "include": [
        "**/*.cs",
        "**/*.csx",
        "**/*.csproj",
        "**/*.props",
        "**/*.targets",
        "**/*.slnx",
        "**/*.xml",
        "**/*.config",
        "**/*.xaml",
        "**/*.axaml"
      ]
    },
    {
      "name": "code-style-check",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "format",
        "style",
        "Micser.slnx",
        "--severity",
        "warn",
        "--no-restore",
        "--verify-no-changes",
        "--include",
        "${staged}"
      ],
      "include": ["**/*.cs"]
    }
  ]
}

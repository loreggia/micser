<Project>
  <PropertyGroup>
    <VersionPrefix>3.0.0</VersionPrefix>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- the code style rules in .editorconfig; IDE0005 (unnecessary usings) needs the documentation file -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <!-- nor those of referenced packages and projects (e.g. WebView2, NAudio) -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <!-- CS1591: missing XML comment, CS1573: undocumented parameter next to documented ones -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <!-- plugin widget packages (Web/) live inside .NET project folders -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Web/**;node_modules/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- NuGet packages: only the plugin SDK (Micser.Audio) is packable -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Authors>Lucas Loreggia</Authors>
    <Copyright>Copyright © Lucas Loreggia</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/loreggia/micser</PackageProjectUrl>
    <RepositoryUrl>https://github.com/loreggia/micser</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="AppHost">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Browsers" Version="17.0.0-preview.1.26567.5" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
  </ItemGroup>
  <ItemGroup Label="Audio">
    <PackageVersion Include="NAudio.Core" Version="3.3.0" />
    <PackageVersion Include="NAudio.Wasapi" Version="3.3.0" />
    <!-- RTKit on Linux; at least Avalonia’s version; the shell references it directly so engine and shell agree -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.95.2" />
  </ItemGroup>
  <ItemGroup Label="Engine">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="11.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup Label="ServiceDefaults">
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
  </ItemGroup>
  <ItemGroup Label="Shell">
    <PackageVersion Include="Avalonia" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Controls.WebView" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageVersion Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
  </ItemGroup>
</Project>

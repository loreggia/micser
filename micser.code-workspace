{
  "folders": [
    {
      "name": "root",
      "path": ".",
    },
    {
      "name": "@micser/web",
      "path": "src/Web",
    },
    {
      "name": "@micser/web-sdk",
      "path": "src/WebSdk",
    },
    {
      "name": "@micser/plugin-main",
      "path": "src/Plugins/Main/Web",
    },
    {
      "name": "Micser.AppHost",
      "path": "tools/AppHost",
    },
    {
      "name": "Micser.Audio",
      "path": "src/Audio",
    },
    {
      "name": "Micser.AudioHarness",
      "path": "tools/AudioHarness",
    },
    {
      "name": "Micser.DriverUtility",
      "path": "src/DriverUtility",
    },
    {
      "name": "Micser.Engine",
      "path": "src/Engine",
    },
    {
      "name": "Micser.Plugins.Main",
      "path": "src/Plugins/Main",
    },
    {
      "name": "Micser.ServiceDefaults",
      "path": "src/ServiceDefaults",
    },
    {
      "name": "Micser.Shell",
      "path": "src/Shell",
    },
    {
      "name": "Micser.Vac",
      "path": "src/Vac",
    },
  ],
  "settings": {
    "dotnet.defaultSolution": "Micser.slnx",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always",
    },
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "files.eol": "\n",
    "files.exclude": {
      "src/Vac/packages": true,
    },
    "files.watcherExclude": {
      "src/Vac/packages": true,
    },
    "i18n-ally.localesPaths": ["src/Web/src/locales", "src/WebSdk/src/i18n", "src/Plugins/Main/Web/src/locales"],
    "powershell.cwd": "root",
  },
  "extensions": {
    "recommendations": [
      "csharpier.csharpier-vscode",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "github.vscode-github-actions",
      "lokalise.i18n-ally",
      "ms-azuretools.vscode-docker",
      "ms-dotnettools.csdevkit",
      "ms-vscode.powershell",
    ],
  },
}

{
  "name": "micser",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && dotnet tool restore && dotnet husky install",
    "setup:ci": "npm ci",
    "dev": "npm run dev -w @micser/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/E2E",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix-line-endings": "node scripts/repair-line-endings.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0"
  },
  "overrides": {
    "undici": "^7.30.0"
  },
  "workspaces": [
    "src/Web",
    "src/WebSdk",
    "src/Plugins/*/Web",
    "tests/E2E"
  ],
  "engines": {
    "node": "^26",
    "npm": "^12"
  },
  "volta": {
    "node": "26.12.1",
    "npm": "12.2.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

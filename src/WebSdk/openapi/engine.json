    "/api/engine": {
      "get": {
        "tags": [
          "Engine"
        ],
        "operationId": "GetEngineStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineStatusDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/engine/start": {
      "post": {
        "tags": [

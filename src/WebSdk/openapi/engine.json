      },
      "ModuleDtoLoopbackInputModule": {
        "required": [
          "state",
          "id",
          "isBypassed",
          "isMuted",
          "volume"
        ],
        "properties": {
          "type": {
            "enum": [
              "LoopbackInput"
            ],
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/LoopbackInputState"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "isBypassed": {
            "type": "boolean"
          },
          "isMuted": {
            "type": "boolean"
          },
          "name": {
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ]
          },
          "position": {

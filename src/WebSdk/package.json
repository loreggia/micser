{
  "name": "@micser/web-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./testing/index.tsx",
    "./vite": "./vite/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate:api": "orval",

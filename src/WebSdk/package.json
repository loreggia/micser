  },
  "peerDependencies": {
    "@fluentui/react-components": "^9.74.11",
    "@microsoft/signalr": "^10.0.11",
    "@tanstack/react-query": "^5.104.5",
    "i18next": "^26.5.5",
    "react": "^19.3.1",
    "react-i18next": "^17.1.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "orval": "^8.44.0",
    "vite": "^8.3.5"
  }
}
